ComputeShader "Zarin/RadianceCascades"
{
    Properties
    {
        _NumCascades("Num Cascades", Int) = 5
        _BaseRange("Range", Float) = 1.0
        _Intensity("GI Intensity", Float) = 1.0
        _TemporalFactor("Temporal Blend", Float) = 0.85
        _SkyIntensity("Sky Intensity", Float) = 1.0
    }

    GLSLPROGRAM
    #version 430 core
    #define ZARIN_HIGH_PRECISION 0
    layout(local_size_x = 8, local_size_y = 8) in;

    #define TAU 6.28318530718
    #define PI 3.14159265359
    #define INV_PI 0.31830988618
    #define EPS 1e-6

    #define MODE_TRACE 0
    #define MODE_RECONSTRUCT 1
    #define MODE_DEBUG_TEST 2
    #define MODE_BLUR_H 3
    #define MODE_BLUR_V 4
    #define MODE_TEMPORAL 5
    #define MODE_DEBUG_ATLAS 6
    #define MODE_NORMALS 8

    #define MAX_INSTANCES 256
    #define MAX_LIGHTS 8

    layout(std430, binding = 0) restrict readonly buffer BVHNodes {
        float bvh_nodes[];
    };
    layout(std430, binding = 1) restrict readonly buffer Vertices {
        float vert_data[];
    };
    layout(std430, binding = 2) restrict readonly buffer Indices {
        uint idx_data[];
    };
    layout(std430, binding = 3) restrict readonly buffer Materials {
        float mat_data[];
    };
    layout(std430, binding = 4) restrict readonly buffer Instances {
        float inst_data[];
    };
    layout(std430, binding = 5) restrict readonly buffer Lights {
        float light_data[];
    };

    layout(binding = 0) uniform sampler2D u_depth_tex;
    layout(binding = 4) uniform sampler2D u_history_tex;
    layout(binding = 5) uniform sampler2D u_gi_input_tex;
    uniform sampler2DArray u_albedo_array;
    uniform sampler2D u_normal_tex;

    uniform vec2 u_screen_size;
    uniform mat4 u_inv_view_proj;
    uniform mat4 u_prev_view_proj;
    uniform vec3 u_camera_pos;
    uniform vec3 u_sky_ambient;
    uniform vec3 u_sun_dir;
    uniform vec3 u_sun_color;
    uniform float u_sun_intensity;
    uniform float u_sky_intensity;
    uniform float u_cam_near;
    uniform float u_cam_far;
    uniform int u_num_cascades;
    uniform float u_intensity;
    uniform float u_temporal_factor;
    uniform int u_mode;
    uniform int u_cascade;
    uniform int u_instance_count;
    uniform int u_light_count;
    uniform int u_albedo_tex_count;
    uniform float u_base_range;
    uniform int u_trace_stride;
    uniform int u_trace_dirs;
    uniform int u_blur_step;

    layout(rgba16f, binding = 2) uniform image2D u_trace;
    layout(rgba32f, binding = 7) uniform image2D u_normal;
    layout(rgba16f, binding = 2) uniform image2D u_cas0;
    layout(rgba16f, binding = 3) uniform image2D u_cas1;
    layout(rgba16f, binding = 4) uniform image2D u_cas2;
    layout(rgba16f, binding = 5) uniform image2D u_cas3;
    layout(rgba16f, binding = 6) uniform image2D u_cas4;
    layout(rgba32f, binding = 7) uniform image2D u_gi_output;

    const int MAX_ALBEDO_LAYERS = 32;

    float ray_aabb_min(vec3 o, vec3 inv_d, vec3 bmin, vec3 bmax) {
        vec3 t1 = (bmin - o) * inv_d;
        vec3 t2 = (bmax - o) * inv_d;
        vec3 tmin_v = min(t1, t2);
        vec3 tmax_v = max(t1, t2);
        float tmin = max(max(tmin_v.x, tmin_v.y), tmin_v.z);
        float tmax = min(min(tmax_v.x, tmax_v.y), tmax_v.z);
        return (tmin > tmax || tmax <= 0.0) ? -1.0 : max(tmin, 0.0);
    }

    vec3 world_from_depth(vec2 uv, float depth) {
        vec4 ndc = vec4(uv * 2.0 - 1.0, depth * 2.0 - 1.0, 1.0);
        vec4 world = u_inv_view_proj * ndc;
        return world.xyz / world.w;
    }

    float linear_eye(float depth) {
        float denom = u_cam_far - depth * (u_cam_far - u_cam_near);
        return u_cam_near * u_cam_far / max(denom, EPS);
    }

    vec3 compute_normal(vec2 uv) {
        vec2 texel = 1.0 / u_screen_size;
        float d = texture(u_depth_tex, uv).r;
        float dpx = texture(u_depth_tex, uv + vec2(texel.x, 0.0)).r;
        float dpy = texture(u_depth_tex, uv + vec2(0.0, texel.y)).r;
        vec3 P = world_from_depth(uv, d);
        vec3 Ppx = world_from_depth(uv + vec2(texel.x, 0.0), dpx);
        vec3 Ppy = world_from_depth(uv + vec2(0.0, texel.y), dpy);
        vec3 dx = Ppx - P;
        vec3 dy = Ppy - P;
        vec3 n = cross(dx, dy);
        float l = length(n);
        n = l > EPS ? n / l : vec3(0.0, 1.0, 0.0);
        vec3 V = u_camera_pos - P;
        float vl = length(V);
        V = vl > EPS ? V / vl : vec3(0.0, 0.0, 1.0);
        if (dot(n, V) < 0.0) n = -n;
        return n;
    }

    const vec3 FIB[64] = vec3[64](
