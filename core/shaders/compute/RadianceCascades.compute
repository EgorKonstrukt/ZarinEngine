        vec3(-0.1568384, 0.7968750, 0.5834312),
        vec3(-0.2964956, 0.7656250, -0.5708842),
        vec3(0.6375587, 0.7343750, 0.2328354),
        vec3(-0.6572709, 0.7031250, 0.2713119),
        vec3(0.3139277, 0.6718750, -0.6708453),
